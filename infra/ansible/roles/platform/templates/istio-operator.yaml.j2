apiVersion: install.istio.io/v1alpha1
kind: IstioOperator
spec:
  profile: default
  components:
    cni:
      enabled: true
    pilot:
      k8s:
        resources:
          requests: { cpu: 100m, memory: 256Mi }
          limits: { memory: 512Mi }
    ingressGateways:
      - name: istio-ingressgateway
        enabled: true
        k8s:
          resources:
            requests: { cpu: 50m, memory: 128Mi }
            limits: { memory: 256Mi }
{% if metallb_ip | length > 0 %}
          serviceAnnotations:
            metallb.io/loadBalancerIPs: "{{ metallb_ip }}"
{% endif %}
          service:
{% if metallb_ip | length > 0 %}
            type: LoadBalancer
            ports:
              - { name: http2, port: 80, targetPort: 8080 }
              - { name: https, port: 443, targetPort: 8443 }
{% else %}
            type: NodePort
            ports:
              - { name: http2, port: 80, targetPort: 8080, nodePort: 30080 }
              - { name: https, port: 443, targetPort: 8443, nodePort: 30443 }
{% endif %}
